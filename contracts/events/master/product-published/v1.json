{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp.example.invalid/contracts/events/master/product-published/v1.json",
  "title": "master.product.published.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "aggregate_guid",
    "aggregate_version",
    "tenant_guid",
    "legal_entity_guid",
    "business_operation_guid",
    "occurred_at",
    "recorded_at",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "master.product.published.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_guid": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_guid": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_guid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "business_operation_guid": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku_guid",
        "code",
        "base_uom_guid",
        "valuation_class",
        "tax_class",
        "product_category",
        "lot_required",
        "serial_required",
        "conversion_versions"
      ],
      "properties": {
        "sku_guid": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string",
          "maxLength": 64
        },
        "base_uom_guid": {
          "type": "string",
          "format": "uuid"
        },
        "valuation_class": {
          "const": "MOVING_AVERAGE"
        },
        "tax_class": {
          "type": "string",
          "minLength": 1
        },
        "product_category": {
          "type": "string",
          "minLength": 1
        },
        "lot_required": {
          "type": "boolean"
        },
        "serial_required": {
          "type": "boolean"
        },
        "conversion_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conversion_guid",
              "uom_guid",
              "numerator",
              "denominator",
              "effective_from"
            ],
            "properties": {
              "conversion_guid": {
                "type": "string",
                "format": "uuid"
              },
              "uom_guid": {
                "type": "string",
                "format": "uuid"
              },
              "numerator": {
                "type": "integer",
                "minimum": 1
              },
              "denominator": {
                "type": "integer",
                "minimum": 1
              },
              "effective_from": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}
