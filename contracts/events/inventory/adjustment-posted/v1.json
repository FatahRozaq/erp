{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp.example.invalid/contracts/events/inventory/adjustment-posted/v1.json",
  "title": "inventory.adjustment.posted.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "aggregate_guid",
    "aggregate_version",
    "tenant_guid",
    "legal_entity_guid",
    "business_operation_guid",
    "occurred_at",
    "recorded_at",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "inventory.adjustment.posted.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_guid": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_guid": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_guid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "business_operation_guid": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjustment_guid",
        "business_date",
        "movement_guids",
        "reason_code",
        "reversal_of_guid",
        "delta_value_base"
      ],
      "properties": {
        "adjustment_guid": {
          "type": "string",
          "format": "uuid"
        },
        "business_date": {
          "type": "string",
          "format": "date"
        },
        "movement_guids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "reversal_of_guid": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "delta_value_base": {
          "type": "string",
          "pattern": "^-?\\d{1,14}(\\.\\d{1,6})?$"
        }
      }
    }
  }
}
