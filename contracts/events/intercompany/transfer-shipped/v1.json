{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp.example.invalid/contracts/events/intercompany/transfer-shipped/v1.json",
  "title": "intercompany.transfer.shipped.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "aggregate_guid",
    "aggregate_version",
    "tenant_guid",
    "legal_entity_guid",
    "business_operation_guid",
    "occurred_at",
    "recorded_at",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "intercompany.transfer.shipped.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_guid": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_guid": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_guid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "business_operation_guid": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_guid",
        "shipment_guid",
        "source_entity_guid",
        "destination_entity_guid",
        "qty_base",
        "transfer_value_base"
      ],
      "properties": {
        "pair_guid": {
          "type": "string",
          "format": "uuid"
        },
        "shipment_guid": {
          "type": "string",
          "format": "uuid"
        },
        "source_entity_guid": {
          "type": "string",
          "format": "uuid"
        },
        "destination_entity_guid": {
          "type": "string",
          "format": "uuid"
        },
        "qty_base": {
          "type": "string",
          "pattern": "^\\d{1,14}(\\.\\d{1,6})?$"
        },
        "transfer_value_base": {
          "type": "string",
          "pattern": "^\\d{1,14}(\\.\\d{1,6})?$"
        }
      }
    }
  }
}
