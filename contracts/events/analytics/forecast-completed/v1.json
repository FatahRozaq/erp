{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp.example.invalid/contracts/events/analytics/forecast-completed/v1.json",
  "title": "analytics.forecast.completed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "aggregate_guid",
    "aggregate_version",
    "tenant_guid",
    "legal_entity_guid",
    "business_operation_guid",
    "occurred_at",
    "recorded_at",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "analytics.forecast.completed.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_guid": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_guid": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_guid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "business_operation_guid": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecast_run_guid",
        "model_version",
        "dataset_watermark",
        "quality_hash",
        "recommendation_count"
      ],
      "properties": {
        "forecast_run_guid": {
          "type": "string",
          "format": "uuid"
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "dataset_watermark": {
          "type": "integer",
          "minimum": 0
        },
        "quality_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recommendation_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
