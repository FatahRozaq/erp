{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp.example.invalid/contracts/events/budget/commitment-changed/v1.json",
  "title": "budget.commitment.changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "aggregate_guid",
    "aggregate_version",
    "tenant_guid",
    "legal_entity_guid",
    "business_operation_guid",
    "occurred_at",
    "recorded_at",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "budget.commitment.changed.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_guid": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_guid": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_guid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "business_operation_guid": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitment_guid",
        "source_guid",
        "budget_guid",
        "delta_held_base",
        "actual_base",
        "status"
      ],
      "properties": {
        "commitment_guid": {
          "type": "string",
          "format": "uuid"
        },
        "source_guid": {
          "type": "string",
          "format": "uuid"
        },
        "budget_guid": {
          "type": "string",
          "format": "uuid"
        },
        "delta_held_base": {
          "type": "string",
          "pattern": "^-?\\d{1,14}(\\.\\d{1,6})?$"
        },
        "actual_base": {
          "type": "string",
          "pattern": "^\\d{1,14}(\\.\\d{1,6})?$"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
