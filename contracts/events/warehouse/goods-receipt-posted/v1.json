{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp.example.invalid/contracts/events/warehouse/goods-receipt-posted/v1.json",
  "title": "warehouse.goods_receipt.posted.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "type", "schema_version", "aggregate_guid", "aggregate_version", "tenant_guid", "legal_entity_guid", "business_operation_guid", "occurred_at", "recorded_at", "correlation_id", "causation_id", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "type": {"const": "warehouse.goods_receipt.posted.v1"},
    "schema_version": {"const": 1},
    "aggregate_guid": {"type": "string", "format": "uuid"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "tenant_guid": {"type": "string", "format": "uuid"},
    "legal_entity_guid": {"type": "string", "format": "uuid"},
    "business_operation_guid": {"type": "string", "format": "uuid"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goods_receipt_guid", "purchase_order_guid", "warehouse_guid", "lines"],
      "properties": {
        "goods_receipt_guid": {"type": "string", "format": "uuid"},
        "purchase_order_guid": {"type": "string", "format": "uuid"},
        "warehouse_guid": {"type": "string", "format": "uuid"},
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["goods_receipt_line_guid", "purchase_order_line_guid", "sku_guid", "accepted_qty_base", "inventory_value_base"],
            "properties": {
              "goods_receipt_line_guid": {"type": "string", "format": "uuid"},
              "purchase_order_line_guid": {"type": "string", "format": "uuid"},
              "sku_guid": {"type": "string", "format": "uuid"},
              "accepted_qty_base": {"type": "string", "pattern": "^\\d{1,14}(\\.\\d{1,6})?$"},
              "inventory_value_base": {"type": "string", "pattern": "^\\d{1,14}(\\.\\d{1,6})?$"}
            }
          }
        }
      }
    }
  }
}
