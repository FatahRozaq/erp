{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp.example.invalid/contracts/events/warehouse/delivery-shipped/v1.json",
  "title": "warehouse.delivery.shipped.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "aggregate_guid",
    "aggregate_version",
    "tenant_guid",
    "legal_entity_guid",
    "business_operation_guid",
    "occurred_at",
    "recorded_at",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "warehouse.delivery.shipped.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_guid": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_guid": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_guid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "business_operation_guid": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_guid",
        "sales_order_guid",
        "business_date",
        "lines"
      ],
      "properties": {
        "delivery_guid": {
          "type": "string",
          "format": "uuid"
        },
        "sales_order_guid": {
          "type": "string",
          "format": "uuid"
        },
        "business_date": {
          "type": "string",
          "format": "date"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "delivery_line_guid",
              "sales_order_line_guid",
              "shipped_qty_base",
              "outbound_unit_cost_base"
            ],
            "properties": {
              "delivery_line_guid": {
                "type": "string",
                "format": "uuid"
              },
              "sales_order_line_guid": {
                "type": "string",
                "format": "uuid"
              },
              "shipped_qty_base": {
                "type": "string",
                "pattern": "^\\d{1,14}(\\.\\d{1,6})?$"
              },
              "outbound_unit_cost_base": {
                "type": "string",
                "pattern": "^\\d{1,14}(\\.\\d{1,6})?$"
              }
            }
          }
        }
      }
    }
  }
}
