{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp.example.invalid/contracts/events/purchase/return-posted/v1.json",
  "title": "purchase.return.posted.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "schema_version",
    "aggregate_guid",
    "aggregate_version",
    "tenant_guid",
    "legal_entity_guid",
    "business_operation_guid",
    "occurred_at",
    "recorded_at",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "purchase.return.posted.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_guid": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_guid": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_guid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "business_operation_guid": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "return_guid",
        "goods_receipt_line_guid",
        "accepted_qty_base",
        "supplier_debit_memo_guid",
        "net_base",
        "tax_base"
      ],
      "properties": {
        "return_guid": {
          "type": "string",
          "format": "uuid"
        },
        "goods_receipt_line_guid": {
          "type": "string",
          "format": "uuid"
        },
        "accepted_qty_base": {
          "type": "string",
          "pattern": "^\\d{1,14}(\\.\\d{1,6})?$"
        },
        "supplier_debit_memo_guid": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "net_base": {
          "type": "string",
          "pattern": "^\\d{1,14}(\\.\\d{1,6})?$"
        },
        "tax_base": {
          "type": "string",
          "pattern": "^\\d{1,14}(\\.\\d{1,6})?$"
        }
      }
    }
  }
}
